<?xml version='1.0' encoding='utf-8'?>
<widget id="com.myd.restaurante" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>MyD Bar &amp; Restaurantes</name>
    <description>App de delivery para pedidos online</description>
    <author email="contato@myd.com.br" href="https://myd.com.br">
        MyD Restaurantes
    </author>
    <content src="index.html" />
    
    <!-- Configurações gerais -->
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <!-- Preferências -->
    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="35" />
    <preference name="BackupWebStorage" value="none" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="FadeSplashScreenDuration" value="300" />
    <preference name="SplashShowOnlyFirstTime" value="false" />
    <preference name="SplashScreen" value="screen" />
    <preference name="SplashScreenDelay" value="3000" />
    
    <!-- Android específico -->
    <platform name="android">
        <icon density="ldpi" src="www/icons/icon-36x36.png" />
        <icon density="mdpi" src="www/icons/icon-48x48.png" />
        <icon density="hdpi" src="www/icons/icon-72x72.png" />
        <icon density="xhdpi" src="www/icons/icon-96x96.png" />
        <icon density="xxhdpi" src="www/icons/icon-144x144.png" />
        <icon density="xxxhdpi" src="www/icons/icon-192x192.png" />
        
        <splash density="land-ldpi" src="www/icons/screen-ldpi-landscape.png" />
        <splash density="land-mdpi" src="www/icons/screen-mdpi-landscape.png" />
        <splash density="land-hdpi" src="www/icons/screen-hdpi-landscape.png" />
        <splash density="land-xhdpi" src="www/icons/screen-xhdpi-landscape.png" />
        <splash density="land-xxhdpi" src="www/icons/screen-xxhdpi-landscape.png" />
        <splash density="land-xxxhdpi" src="www/icons/screen-xxxhdpi-landscape.png" />
        <splash density="port-ldpi" src="www/icons/screen-ldpi-portrait.png" />
        <splash density="port-mdpi" src="www/icons/screen-mdpi-portrait.png" />
        <splash density="port-hdpi" src="www/icons/screen-hdpi-portrait.png" />
        <splash density="port-xhdpi" src="www/icons/screen-xhdpi-portrait.png" />
        <splash density="port-xxhdpi" src="www/icons/screen-xxhdpi-portrait.png" />
        <splash density="port-xxxhdpi" src="www/icons/screen-xxxhdpi-portrait.png" />
        
        <allow-intent href="market:*" />
    </platform>
    
    <!-- Acesso à rede -->
    <access origin="*" />
    
    <!-- Plugins -->
    <plugin name="cordova-plugin-whitelist" spec="1" />
    <plugin name="cordova-plugin-vibration" spec="3" />
    <plugin name="cordova-plugin-device" spec="2" />
    <plugin name="cordova-plugin-network-information" spec="3" />
    <plugin name="cordova-plugin-splashscreen" spec="6" />
</widget>
